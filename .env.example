# This file is informational only. Never commit secrets to GitHub.
# For Render simulation, put values in Render Dashboard Environment settings.
LIVECAST_REMOTE_TEST=1
LIVECAST_DB=/tmp/livecast-demo.sqlite3
OPERATOR_PASSWORD=REPLACE_WITH_RANDOM_12_PLUS_CHAR_PASSWORD
VIEW_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_24_PLUS_CHAR_TOKEN

# Optional real public YouTube Super Chat feed for v0.4 DEMO (server-side secret):
YOUTUBE_API_KEY=ADD_THIS_ONLY_TO_RENDER_ENVIRONMENT_NOT_GITHUB
# Configure the video URL and enable listening in the protected operator YouTube tab.
YOUTUBE_MIN_POLL_SECONDS=50
# Optional startup defaults (operator can override while running):
YOUTUBE_ENABLED=0
YOUTUBE_VIDEO_ID=

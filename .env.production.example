# SAMPLE ONLY — do not commit your real secrets.
LIVECAST_ENV=production
LIVECAST_REMOTE_TEST=1
LIVECAST_DB=/var/data/livecast.sqlite3
LIVECAST_PERSISTENT_ROOT=/var/data
LIVECAST_REQUIRE_MOUNT=1
LIVECAST_SERVER_QUEUE=1
LIVECAST_ALERT_SECONDS=6
PUBLIC_OVERLAYS=1
PAGES_ORIGIN=https://heathlyon.github.io
LIVECAST_PAGES_URL=https://heathlyon.github.io/Live_Cast_Control_Room/
# LIVECAST_PUBLIC_URL automatically uses Render RENDER_EXTERNAL_URL
# YOUTUBE_API_KEY=YOUR_PRIVATE_KEY # add only when the channel is available
# Generate per-user hashes with python scripts/create_user_hash.py
# JSON value contains username -> role and password_hash; put it in Render secret env.
LIVECAST_USERS_JSON={"director":{"role":"admin","password_hash":"scrypt$16384$8$1$REPLACE_SALT$REPLACE_HASH"}}
VIEW_TOKEN=YOUR_PRIVATE_LONG_VIEWER_TOKEN
